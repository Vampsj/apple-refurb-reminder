<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.apple-refurb-reminder</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_PROJECT_PATH/.venv/bin/apple-refurb-reminder</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_PROJECT_PATH</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_PROJECT_PATH/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_PROJECT_PATH/logs/launchd.err.log</string>
</dict>
</plist>
